# MongoDB (also used to build the backend MONGO_URI)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

# Redis
REDIS_PASSWORD=redispassword123

# MinIO (hot store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=newbucket

# AWS S3 (cold store; optional but required for the nightly mirror)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
AWS_S3_BUCKET=minioands3

# Browser-reachable API URL baked into the frontend bundle at build time
VITE_API_BASE_URL=http://localhost:8000
